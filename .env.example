# Sample Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_USER=payments
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=payments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://payments:your_secure_password_here@postgres:5432/payments

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://payments:your_rabbitmq_password_here@rabbitmq:5672

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# API Configuration
API_PORT=3000
NODE_ENV=development

# Worker Configuration
WORKER_CONCURRENCY=1

# Mock Gateway Configuration (optional)
GATEWAY_SUCCESS_RATE=70
GATEWAY_RETRYABLE_RATE=20
